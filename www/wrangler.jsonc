{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sonicjs-docs",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Contact form sends real SMTP via Namecheap Private Email (worker-mailer,
  // over Cloudflare TCP Sockets) — not Cloudflare Email Routing.
  // SMTP_USER / SMTP_PASS are secrets: set them with
  // `wrangler secret put SMTP_USER` / `wrangler secret put SMTP_PASS` in prod,
  // and in www/.dev.vars (gitignored) for local dev — never put them here.
  "vars": {
    "SMTP_HOST": "mail.privateemail.com",
    "SMTP_PORT": "587",
    // Recipient + sender live here (not in the page) so the address is never published.
    "SUPPORT_INBOX": "hello@sonicjs.com",
    "SUPPORT_FROM": "hello@sonicjs.com"
  }
}
